# Copy to .env and fill in. Never commit the real .env.

# Admin login (required, basic auth for /admin and the write API)
SIGNAGE_ADMIN_USER=admin
SIGNAGE_ADMIN_PASS=change-me-to-a-long-random-password

# Host port for http://localhost:<port> (optional, default 8080)
SIGNAGE_PORT=8080

# Branding (optional, placeholders shown here are the compose defaults)
SIGNAGE_BRAND_NAME=Your Brand
SIGNAGE_BRAND_EMAIL=info@example.com
SIGNAGE_BRAND_PHONE=+000 000 000 000
SIGNAGE_BRAND_CITY=Your City
SIGNAGE_BRAND_URL=https://example.com/
SIGNAGE_BRAND_QR_EMAIL=info@example.com
SIGNAGE_BRAND_PWA_TITLE=Signage
